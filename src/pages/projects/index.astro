---
import Base from '../../layouts/Base.astro';
import { projects, categories } from '../../data/projects';
---
<Base title="Projects" active="projects" description="Projects by Joselyn Garcia: startup work, client work, case competitions and creative content.">
  <section class="wrap page-head">
    <p class="eyebrow">Projects</p>
    <h1>All projects.</h1>
    <p class="lede">Startup work, client work, competitions and creative content. Looking for vibe-coded apps? They live in the <a href="/playground">Playground</a>.</p>
    <div class="chips" role="tablist" aria-label="Filter projects by category" data-chips>
      <button type="button" role="tab" aria-selected="true" data-c="All">All</button>
      {categories.map((c) => <button type="button" role="tab" aria-selected="false" data-c={c}>{c}</button>)}
    </div>
  </section>
  <section class="wrap group" aria-label="Projects">
    <div class="grid" data-grid>
      {projects.map((p) => (
        <a class="card" href={p.href} data-c={p.category}>
          <span class="frame"><img src={p.cover} alt="" loading="lazy" /></span>
          <span class="tags">{p.category} · {p.sub}</span>
          <b>{p.title}</b>
          <span class="sum" set:html={p.summary}></span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .page-head { padding: 130px 0 10px; }
  .page-head h1 { font-size: clamp(2.6rem, 6vw, 4.4rem); letter-spacing: -0.045em; }
  .lede a { color: var(--ink); text-underline-offset: 3px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; }
  .chips button { min-height: 40px; padding: 8px 16px; border: 1px solid var(--line); border-radius: 999px; background: #fff; color: var(--ink-2); font: 600 0.92rem var(--sans); cursor: pointer; transition: background 0.2s, color 0.2s, border-color 0.2s; }
  .chips button:hover { border-color: var(--ink); color: var(--ink); }
  .chips button[aria-selected='true'] { background: #111; border-color: #111; color: #fff; }
  .group { padding-top: 40px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 34px 22px; }
  .card { display: block; color: var(--ink); text-decoration: none; }
  .card[hidden] { display: none; }
  .frame { display: block; aspect-ratio: 16 / 11; padding: 18px; border-radius: 22px; background: #f4f4f4; overflow: hidden; }
  .frame img { width: 100%; height: 100%; object-fit: cover; border-radius: 12px; transition: transform 0.5s var(--ease); }
  .card:hover .frame img { transform: translateY(-4px); }
  .tags { display: block; margin: 14px 0 4px; font-size: 0.76rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
  .card b { display: block; font-size: 1.2rem; letter-spacing: -0.02em; margin-bottom: 4px; }
  .sum { display: block; color: var(--ink-2); font-size: 0.96rem; line-height: 1.5; }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>

<script>
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-chips] button')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-grid] .card')];
  const pick = (c: string) => {
    chips.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.c === c)));
    cards.forEach((card) => { card.hidden = c !== 'All' && card.dataset.c !== c; });
  };
  chips.forEach((b) => b.addEventListener('click', () => pick(b.dataset.c!)));
</script>
