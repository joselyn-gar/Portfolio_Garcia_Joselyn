---
// "What I did" opener for a case study: 3 concrete contributions, each can link to proof (slides, report, live app).
interface Props { items: [string, string][]; heading?: string; }
const { items, heading = 'What I did' } = Astro.props;
---
<section class="chapter">
  <span class="num">What I did</span>
  <h2>{heading}</h2>
  <ol class="band did">
    {items.map(([title, body]) => <li><b>{title}</b><span set:html={body}></span></li>)}
  </ol>
  <slot />
</section>

<style>
  .did { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; text-align: left; counter-reset: d; }
  .did li { counter-increment: d; padding: 24px; border-radius: 20px; background: var(--white); }
  .did li::before { content: '0' counter(d); display: block; font-weight: 700; font-size: 0.8rem; color: var(--ink-3); margin-bottom: 10px; }
  .did b { display: block; font-size: 1.2rem; letter-spacing: -0.02em; margin-bottom: 6px; }
  .did span { color: var(--ink-2); font-size: 1rem; line-height: 1.5; }
  .did :global(a) { color: var(--ink); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 760px) { .did { grid-template-columns: 1fr; } }
</style>
