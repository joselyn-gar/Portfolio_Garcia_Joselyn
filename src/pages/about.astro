---
import Base from '../layouts/Base.astro';
import FlipCard from '../components/FlipCard.astro';
import { site } from '../data/site';
import icons from '../data/tool-icons.json';

// App-style tiles: official glyph where one is available, brand-colored monogram otherwise.
const tools = [
  { name: 'Figma', use: 'UI, wireframes, prototypes', bg: '#1e1e1e', glyph: 'figma' },
  { name: 'Framer', use: 'interactive sites', bg: '#0055ff', glyph: 'framer' },
  { name: 'Canva', use: 'social + decks', bg: 'linear-gradient(135deg,#00c4cc,#7d2ae8)', mono: 'Ca' },
  { name: 'Illustrator', use: 'posters, prints, vector', bg: '#330000', fg: '#ff9a00', mono: 'Ai' },
  { name: 'Photoshop', use: 'photo + mockups', bg: '#001e36', fg: '#31a8ff', mono: 'Ps' },
  { name: 'Procreate', use: 'sketching + illustration', bg: 'linear-gradient(135deg,#1c1c1e,#3a3a3c)', mono: 'Pc' },
  { name: 'Blender', use: '3D renders', bg: '#e87d0d', glyph: 'blender' },
  { name: 'Excel', use: 'financial projections', bg: '#217346', mono: 'X' },
  { name: 'CapCut', use: 'reels + recap videos', bg: '#000000', mono: 'Cc' },
  { name: 'Claude', use: 'research + building', bg: '#d97757', glyph: 'claude' },
];
const now = [
  ['Skandalaris Center', 'Digital Content + Website Lead Intern'],
  ['Center for Experiential Learning', 'UX Consultant, B2B platform practicum'],
  ['WUTV', 'PR Executive, membership 3 → 20'],
];
const strengths = [
  ['Arranger', 'I plan the deadlines, meetings, and agendas, then delegate by who’s available and ready.'],
  ['Learner', 'I love the process of learning, and I can break a hard topic down so it clicks for a teammate.'],
  ['Achiever', 'I keep the team ahead of deadlines, and I choose impact over doing more for the sake of it.'],
  ['Individualization', 'I spot where each teammate shines and hand out work to match.'],
  ['Input', 'I dig deep into research, then brief the team in short, usable summaries.'],
];
const patterns = ['dots', 'stripes', 'checks', 'grid', 'rings', 'sunburst'] as const;
const hobbies = [
  { front: 'Watching baseball', back: '', color: 'write', img: '/images/about/dodgers.webp' },
  { front: 'Video production', back: '', color: 'tex', img: '/images/about/video.webp' },
  { front: 'Jazz', back: '', color: 'lyft', img: '/images/about/jazz.webp' },
  { front: 'Agriculture operations', back: '', color: 'jdel', img: '/images/about/agriculture.webp', pos: 'center 22%' },
  { front: 'Board games', back: 'A favorite way to unwind with friends.', color: 'stl' },
  { front: 'Vibe coding', back: '', color: 'skate', img: '/images/about/vibe-coding.webp', fit: 'contain' },
];
---
<Base title="About" active="about" description="About Joselyn Garcia: WashU Marketing + Entrepreneurship student, HCI minor, founder of ReLeaf Candles.">
  <header class="hero">
    <img class="portrait" src="/images/about/portrait.webp" alt="Joselyn Garcia smiling in a striped polo on campus" />
    <div class="intro">
      <p class="eyebrow">About me</p>
      <h1>Hi, I’m Joselyn.</h1>
      <p class="tagline">Marketing + Entrepreneurship at <strong>WashU</strong>, minoring in <strong>Human-Computer Interaction</strong>.</p>
      <p class="body">I love <strong class="sunset">client-facing work</strong>, <strong class="sunset">creativity</strong>, and turning an idea into something I can <strong class="sunset">see and test</strong>.</p>
      <p class="body">That’s what led me to found <a href="/projects/releaf"><strong>ReLeaf Candles</strong></a>, and it’s how I’ve approached every project since: marketing, product, and UX, all aimed at real people.</p>
      <div class="cta">
        <a class="btn" href={`mailto:${site.email}`}>Email me</a>
        <a class="btn ghost" href={site.resume || "/resume"} target="_blank" rel="noopener">Resume ↗</a>
        {site.linkedin && <a class="btn ghost" href={site.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>}
      </div>
    </div>
  </header>

  <section class="band-sec" aria-labelledby="now-h">
    <p class="eyebrow">Right now</p>
    <h2 id="now-h">Where you’ll find me.</h2>
    <ul class="now three">
      {now.map(([org, role]) => <li><b>{org}</b><span>{role}</span></li>)}
    </ul>
  </section>

  <section class="band-sec" id="strengths" aria-labelledby="str-h">
    <p class="eyebrow">Clifton Strengths</p>
    <h2 id="str-h">How I show up on a team.</h2>
    <p class="hint">Hover or tap a card to flip it.</p>
    <div class="cards five">
      {strengths.map(([s, b], i) => <FlipCard kicker={`Strength ${i + 1}`} front={s} back={b} color={['skate', 'write', 'lyft', 'stl', 'tex'][i]} pattern={patterns[i]} />)}
    </div>
  </section>

  <section class="band-sec" id="toolbox" aria-labelledby="tool-h">
    <p class="eyebrow">Toolbox</p>
    <h2 id="tool-h">What I build with.</h2>
    <div class="tool-marquee" aria-label="Tools I use">
      <ul class="tool-track">
        {[...tools, ...tools].map((t, i) => (
          <li aria-hidden={i >= tools.length ? 'true' : undefined}>
            <span class="app" style={`background:${t.bg};color:${t.fg ?? '#fff'}`} aria-hidden="true">
              {t.glyph
                ? <svg viewBox="0 0 24 24" width="34" height="34"><path d={(icons as Record<string, string>)[t.glyph]} fill="currentColor" /></svg>
                : <span class="mono">{t.mono}</span>}
            </span>
            <b>{t.name}</b>
            <span class="use">{t.use}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band-sec" id="away" aria-labelledby="away-h">
    <p class="eyebrow">Off the clock</p>
    <h2 id="away-h">Away from the desk.</h2>
    <p class="hint">Tap a card to flip it.</p>
    <div class="cards three">
      {hobbies.map((h, i) => <FlipCard kicker="Hobby" front={h.front} back={h.back} color={h.color} img={h.img} fit={h.fit} pos={h.pos} pattern={patterns[(i + 2) % patterns.length]} />)}
    </div>
    {site.pinterest && <p><a class="btn ghost" href={site.pinterest} target="_blank" rel="noopener">See my Pinterest boards ↗</a></p>}
    <p class="site-note" id="site">The little dog following your cursor can be switched off in the footer.</p>
  </section>
</Base>

<style>
  /* left-aligned, F-pattern layout on the same 1040px column as the case studies */
  .hero, .band-sec { width: min(100% - 40px, 1040px); margin: 0 auto; }
  .hero { display: grid; grid-template-columns: minmax(0, 400px) 1fr; gap: 56px; align-items: center; padding: 130px 0 64px; }
  .portrait { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: center 30%; border-radius: 24px; box-shadow: 0 24px 60px rgba(26, 26, 26, 0.14); }
  .hero h1 { font-size: clamp(2.8rem, 6vw, 4.6rem); margin-bottom: 0.2em; }
  .tagline { font-size: clamp(1.15rem, 1.8vw, 1.35rem); color: var(--ink-2); margin: 0 0 22px; }
  .body { font-size: 1.1rem; line-height: 1.6; color: var(--ink-2); margin: 0 0 12px; }
  .body a { color: var(--ink); }
  .band-sec { padding: 56px 0; border-top: 1px solid var(--line); }
  .band-sec h2 { font-size: clamp(1.8rem, 3vw, 2.4rem); margin-bottom: 0.4em; }
  .now { list-style: none; padding: 0; margin: 20px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .now li { padding: 22px 24px; border-radius: 20px; background: var(--white); }
  .now b { display: block; font-size: 1.15rem; letter-spacing: -0.01em; line-height: 1.25; margin-bottom: 6px; }
  .now span { color: var(--ink-2); line-height: 1.5; }
  .hint { color: var(--ink-3); margin: 0; }
  .cards { display: grid; gap: 18px; margin-top: 24px; }
  .cards.five { grid-template-columns: repeat(5, 1fr); }
  .cards.three { grid-template-columns: repeat(3, 1fr); }
  .cards.five :global(.f) { font-size: 1.12rem; overflow-wrap: anywhere; }
  .tool-marquee { margin-top: 24px; overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .tool-track { list-style: none; margin: 0; padding: 12px 0 20px; display: flex; gap: 20px; width: max-content; animation: tools-scroll 38s linear infinite; }
  .tool-marquee:hover .tool-track { animation-play-state: paused; }
  @keyframes tools-scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .tool-track { animation: none; flex-wrap: wrap; width: auto; } .tool-track li[aria-hidden] { display: none; } }
  .tool-track li { flex: none; width: 180px; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 26px 16px 22px; border-radius: 22px; background: var(--white); }
  .app { display: grid; place-items: center; width: 80px; height: 80px; border-radius: 18px; box-shadow: 0 10px 24px rgba(26, 26, 26, 0.18), inset 0 0 0 1px rgba(255, 255, 255, 0.08); margin-bottom: 12px; transition: transform 0.3s var(--ease); }
  .tool-track li:hover .app { transform: translateY(-4px) rotate(-3deg); }
  .mono { font: 700 1.55rem/1 var(--sans); letter-spacing: -0.02em; }
  .tool-track b { font-size: 1.1rem; line-height: 1.2; }
  .use { font-size: 0.85rem; color: var(--ink-3); margin-top: 2px; }
  .site-note { margin-top: 40px; color: var(--ink-2); }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 24px; }
  @media (max-width: 1080px) { .cards.five { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; gap: 32px; padding-top: 110px; }
    .portrait { max-width: 260px; }
  }
  @media (max-width: 760px) {
    .now { grid-template-columns: 1fr; }
    .cards.five, .cards.three { grid-template-columns: repeat(2, 1fr); }
    .band-sec { padding: 44px 0; }
  }
  @media (max-width: 480px) { .cards.five, .cards.three { grid-template-columns: 1fr; } }
</style>
