---
import ProductLayout from '../../layouts/ProductLayout.astro';
import Video from '../../components/Video.astro';
import InstagramEmbed from '../../components/InstagramEmbed.astro';

const asb = [
  ['/images/design/asb-love-like-a-viking.webp', 'Spirit week graphic: Love Like a Viking, 2/11 to 2/14, a red heart in a pink bow stamp frame', '<strong>Spirit week</strong> · Love Like a Viking'],
  ['/images/design/asb-duo-day.webp', 'Duo Day Wednesday graphic with Grease and La La Land couples on a torn paper heart collage', '<strong>Spirit week</strong> · Duo Day'],
  ['/images/design/asb-ice-cream-social.webp', 'Think Gold Ice Cream Social flyer, February 21, with a retro sundae illustration and dripping frosting', '<strong>Event flyer</strong> · Ice Cream Social'],
];

const wutvPosts = [
  { url: 'https://www.instagram.com/reel/Dde_t3GvLN8/', label: 'WUTV reel' },
  { url: 'https://www.instagram.com/reel/Dc4jpf8OLX8/', label: 'WUTV reel' },
  { url: 'https://www.instagram.com/p/DdbsiaMjrf7/', label: 'WUTV post' },
];
---
<ProductLayout
  slug="social"
  eyebrow="Creative content · Social media"
  title="Social Media"
  tagline="<strong>4+ years</strong> of content. I run social for the <strong>Skandalaris Center</strong> and <strong>WUTV</strong>."
  hero="/images/design/hero-reels.webp"
  heroAlt="Three social reels side by side for the Skandalaris Center, WUTV, and West High ASB"
>
  <section class="chapter">
    <h2>On Instagram</h2>
    <p class="lead">Live on the WUTV feed.</p>
    <p>I run the <strong>WUTV</strong> account. Here’s what’s posted right now.</p>
    <div class="band"><InstagramEmbed posts={wutvPosts} handle="wutv_22" /></div>
  </section>

  <section class="chapter">
    <h2>Reels</h2>
    <p class="lead">Pacing is everything.</p>
    <p>Film edits for fun in 2020 became <strong>recaps and reels</strong> built on pacing and emotion.</p>
    <div class="band reels">
      <Video name="skandalaris-welcome" frame="phone" label="Animated welcome post: Welcome! Your journey starts here" caption="Skandalaris · Welcome post" />
      <Video name="skandalaris-ie-awards" frame="phone" label="TikTok promoting the WashU I&E Awards" caption="Skandalaris · I&E Awards" />
      <Video name="wutv-tiny-desk" frame="phone" label="TikTok: sign up for our Tiny Desk Concert" caption="WUTV · Tiny Desk sign-ups" />
    </div>
  </section>

  <section class="chapter">
    <h2>Where it started</h2>
    <p class="lead">High school ASB.</p>
    <p><strong>Spirit week graphics</strong>, flyers, and recaps for <strong>West High ASB</strong>, where I first learned to tell a story in 15 seconds.</p>
    <div class="band asb">
      {asb.map(([src, alt, cap]) => (
        <figure><span><img src={src} alt={alt} loading="lazy" /></span><figcaption set:html={cap}></figcaption></figure>
      ))}
    </div>
    <div class="band reels two">
      <Video name="asb-home-game" frame="phone" label="First home game recap reel" caption="Home game recap" />
      <Video name="asb-staff-breakfast" frame="phone" label="Staff appreciation breakfast recap reel" caption="Staff breakfast recap" />
    </div>
  </section>
</ProductLayout>

<style>
  .reels { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; text-align: left; }
  .asb { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; text-align: left; }
  .asb figure { margin: 0; }
  .asb span { display: flex; align-items: center; aspect-ratio: 4 / 5; }
  .reels.two { grid-template-columns: repeat(2, 1fr); max-width: 640px; }
  @media (max-width: 640px) { .asb { grid-template-columns: 1fr; } .reels { grid-template-columns: repeat(2, 1fr); gap: 16px; } }
</style>
