---
// Apple-product-page style case study: centered headlines, generous space, one idea per chapter,
// big borderless visuals, alternating full-bleed bands.
import Base from './Base.astro';
import { items, nextItem } from '../data/projects';

interface Props {
  slug: string;
  eyebrow: string;
  title: string;
  tagline: string;
  hero: string;
  heroAlt: string;
  summary: [string, string][]; // 10-second summary: label, text (may contain <strong>)
  section?: 'projects' | 'playground';
  heroTall?: boolean;
  overview?: [string, string][]; // at-a-glance facts: context, deliverable, tools, team // portrait hero: shown narrower so it fits the screen
}
const { slug, eyebrow, title, tagline, hero, heroAlt, summary, section = 'projects', heroTall = false, overview = [] } = Astro.props;
const item = items.find((i) => i.slug === slug)!;
const next = nextItem(slug);
---
<Base title={title} description={tagline} active={section} color={item.color} image={hero}>
  <article class="product">
    <div class="read-progress" aria-hidden="true"><span data-progress></span></div>
    <header class="p-hero">
      <p class="role"><span>My role</span>{item.role}</p>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="tagline" set:html={tagline}></p>
      {overview.length > 0 && (
        <dl class="overview" aria-label="Project overview">
          {overview.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
      )}
      <img class:list={['p-hero-img', { tall: heroTall }]} src={hero} alt={heroAlt} />
    </header>

    <section class="p-summary" aria-label="Summary">
      {summary.map(([k, v]) => <div><h2>{k}</h2><p set:html={v}></p></div>)}
    </section>

    <!-- jump-to contents: built from each chapter's label; sticky rail on desktop, pill + sheet on phones -->
    <nav class="toc" aria-label="On this page" data-toc hidden>
      <p class="toc-title">On this page</p>
      <ol data-toc-list></ol>
    </nav>
    <button class="toc-pill" type="button" aria-expanded="false" data-toc-pill hidden><span data-toc-current>Contents</span> <span aria-hidden="true">▾</span></button>

    <div data-chapters>
      <slot />
    </div>

    <!-- Next up: the next project as a simple card -->
    <a class="p-next" href={next.href}>
      <span class="next-img"><img src={next.cover} alt="" loading="lazy" /></span>
      <span class="next-copy">
        <span class="eyebrow">Next project</span>
        <span class="p-next-title">{next.title}</span>
        <span class="next-cta">{next.kind === 'Case study' ? 'Read the case study' : 'Take a look'} <span class="go-arrow" aria-hidden="true">→</span></span>
      </span>
    </a>
  </article>
</Base>

<style is:global>
  .product { --band: 1040px; --text: 680px; }
  .p-hero { padding: 128px 20px 0; text-align: center; }
  .role { display: inline-flex; align-items: center; gap: 10px; margin: 0 auto 22px; padding: 7px 16px 7px 7px; border-radius: 999px; background: var(--paper-2); font-weight: 600; font-size: 0.95rem; color: var(--ink); }
  .overview { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 36px; max-width: 900px; margin: 30px auto 0; padding: 18px 0 0; border-top: 1px solid var(--line); text-align: left; }
  .overview div { min-width: 0; }
  .overview dt { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
  .overview dd { margin: 2px 0 0; font-weight: 600; font-size: 0.98rem; }
  .role { max-width: calc(100% - 8px); text-align: left; }
  .role span { flex: none; white-space: nowrap; }
  @media (max-width: 640px) { .overview { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 18px; justify-content: stretch; } .role { font-size: 0.88rem; } }
  .role span { padding: 4px 10px; border-radius: 999px; background: var(--ink); color: #fff; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .p-hero h1 { font-size: clamp(3.2rem, 8vw, 6rem); letter-spacing: -0.01em; margin: 0 0 0.2em; }
  .tagline { font-size: clamp(1.2rem, 2vw, 1.55rem); color: var(--ink-2); max-width: 720px; margin: 0 auto; line-height: 1.4; }
  .p-hero-img { background: var(--tint); width: min(100%, var(--band)); margin: 56px auto 0; border-radius: 28px; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.1); }

  .p-hero-img.tall { width: min(100%, 520px); }
  .p-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; width: min(100% - 40px, var(--band)); margin: 56px auto 0; text-align: center; }
  .p-summary h2 { font-family: var(--sans); font-weight: 700; font-size: 0.85rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-text); margin-bottom: 10px; }
  .p-summary p { font-size: 1.15rem; color: var(--ink-2); margin: 0; line-height: 1.5; }

  /* chapters: full-bleed bands, centered headline, then content */
  .chapter { padding: 84px 20px; text-align: center; scroll-margin-top: 80px; }
  .chapter > * { max-width: var(--text); margin-left: auto; margin-right: auto; }
  .chapter > .band { max-width: var(--band); }
  .chapter .num { display: block; font-family: var(--sans); font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent-text); margin-bottom: 14px; letter-spacing: 0.04em; }
  .chapter h2 { font-size: clamp(2rem, 3.8vw, 3.1rem); letter-spacing: -0.035em; margin-bottom: 0.35em; text-wrap: balance; }
  .chapter > p, .tagline, .learn p { text-wrap: pretty; }
  .chapter > p { font-size: 1.25rem; color: var(--ink-2); line-height: 1.55; }
  .chapter img, .chapter video { border-radius: 22px; }
  .band { margin-top: 40px; }
  .band img { width: 100%; box-shadow: 0 16px 48px rgba(0, 0, 0, 0.08); }

  .bigstats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .bigstats b { display: block; font-family: var(--serif); font-size: clamp(3.2rem, 7vw, 5.2rem); letter-spacing: -0.01em; line-height: 1; color: var(--accent-text); }
  .bigstats span { display: block; margin-top: 12px; font-size: 1.1rem; color: var(--ink-2); }

  .pull { font-family: var(--serif); font-weight: 650; font-size: clamp(1.5rem, 3vw, 2.2rem); letter-spacing: -0.01em; line-height: 1.25; color: var(--ink); }
  .chapter > p.pull, .band > p.pull { font-size: clamp(1.6rem, 3.2vw, 2.4rem); line-height: 1.25; color: var(--ink); max-width: 820px; }
  .pull + .pull { margin-top: 28px; }
  .pull cite { display: block; margin-top: 10px; font: 400 0.95rem var(--sans); color: var(--ink-3); font-style: normal; }

  .learn { margin-top: 44px !important; padding-top: 28px; border-top: 1.5px solid var(--accent); }
  .learn b { display: block; font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-text); margin-bottom: 8px; }
  .learn p { margin: 0; font-family: var(--serif); font-weight: 650; font-size: 1.7rem; line-height: 1.35; letter-spacing: -0.01em; color: var(--ink); }

  .cols { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px; align-items: start; }
  .cols figcaption, .band figcaption { margin-top: 14px; font-size: 1.05rem; color: var(--ink-2); }
  .takeaways-big { list-style: none; padding: 0; display: grid; gap: 22px; text-align: left; counter-reset: t; }
  .takeaways-big li { counter-increment: t; display: grid; grid-template-columns: 56px 1fr; align-items: baseline; font-size: 1.6rem; font-family: var(--serif); font-weight: 650; letter-spacing: -0.01em; }
  .takeaways-big li::before { content: '0' counter(t); color: var(--accent-text); font-size: 1rem; }

  .p-next { display: flex; align-items: center; justify-content: center; gap: 36px; padding: 120px 20px 40px; text-decoration: none; }
  .next-img { flex: none; width: 260px; aspect-ratio: 16 / 11; padding: 12px; border-radius: 18px; background: #f4f4f4; overflow: hidden; }
  .next-img img { width: 100%; height: 100%; object-fit: cover; border-radius: 10px; transition: transform 0.5s var(--ease); }
  .p-next:hover .next-img img { transform: translateY(-3px); }
  .next-copy { display: block; text-align: left; }
  .next-copy .eyebrow { display: block; margin-bottom: 6px; }
  .p-next-title { display: block; margin-bottom: 14px; font-weight: 700; font-size: clamp(1.8rem, 3.4vw, 2.6rem); line-height: 1.05; letter-spacing: -0.04em; color: var(--ink); }
  .next-cta { display: inline-flex; align-items: center; gap: 8px; padding: 11px 18px; border-radius: 999px; background: #111; color: #fff; font-weight: 600; font-size: 0.95rem; }
  .go-arrow { transition: transform 0.35s var(--ease); }
  .p-next:hover .go-arrow { transform: translateX(6px); }

  .decisions { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; text-align: left; }
  .decisions li { display: flex; gap: 14px; }
  .decisions i { flex: none; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--ink); color: #fff; font: 700 0.8rem var(--sans); font-style: normal; }
  .decisions b { display: block; font-family: var(--serif); font-weight: 650; font-size: 1.6rem; margin-bottom: 4px; }
  .decisions span { color: var(--ink-2); font-size: 1.05rem; line-height: 1.5; }
  .cols figure, figure.band { margin-left: auto; margin-right: auto; margin-bottom: 0; }
  .note { font-size: 0.95rem !important; color: var(--ink-3) !important; margin-top: 28px !important; }

  .hl { color: var(--accent-text); }
  .pull em { font-style: normal; color: var(--accent-text); }
  .ideas { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(var(--n, 4), 1fr); gap: 16px; text-align: left; }
  .ideas li { padding: 22px; border-radius: 20px; background: var(--white); }
  .ideas b { display: block; font-family: var(--serif); font-weight: 650; font-size: 1.55rem; margin-bottom: 6px; }
  .ideas span { font-size: 1.02rem; color: var(--ink-2); }
  .ideas .out { opacity: 0.55; }
  .ideas .out b { text-decoration: line-through; text-decoration-thickness: 2px; }
  .ideas .kept { position: relative; background: #fff; color: var(--ink); box-shadow: inset 0 0 0 2px var(--accent-text); }
  .ideas .kept { padding-top: 52px; }
  .ideas .kept::after { content: 'Chosen'; position: absolute; top: 18px; left: 22px; padding: 3px 10px; border-radius: 999px; background: var(--accent-text); color: #fff; font: 700 0.7rem var(--sans); letter-spacing: 0.06em; text-transform: uppercase; }
  .ideas .kept span, .ideas .kept strong { color: var(--ink-2); }
  .ideas .kept strong { color: var(--ink); }
  .mycall { margin-top: 88px; padding: 48px 32px; border-radius: 28px; background: var(--white); }
  .mycall .num {  margin-bottom: 18px; }
  .mycall .answer { color: var(--ink-2); font-size: clamp(1.2rem, 2.2vw, 1.6rem); }
  .ideas .n { display: block; font: 700 0.8rem var(--sans); color: var(--accent-text); margin-bottom: 8px; }
  .ideas .kept .n { color: var(--accent-text); }
  .bigstats.four { grid-template-columns: repeat(4, 1fr); }
  .cols.three { grid-template-columns: repeat(3, 1fr); }
  .cols.four { grid-template-columns: repeat(4, 1fr); }

  @media (max-width: 860px) { .ideas, .bigstats.four, .cols.four { grid-template-columns: repeat(2, 1fr); } .cols.three { grid-template-columns: 1fr; } }
  @media (max-width: 760px) {
    .decisions { grid-template-columns: 1fr; }
    .p-summary, .bigstats, .cols { grid-template-columns: 1fr; gap: 28px; }
    .chapter { padding: 60px 20px; }
    .p-next { flex-direction: column; gap: 36px; padding-top: 80px; }
    .next-img { width: 100%; }
    .next-copy { text-align: center; }
  }

  /* F-pattern layout: one strong left edge for every heading, label and paragraph, so readers can
     scan down the left side; sections are separated by hairlines instead of large empty gaps. */
  .p-hero { width: min(100% - 40px, var(--band)); margin: 0 auto; padding: 116px 0 0; text-align: left; }
  .role { margin: 0 0 16px; }
  .p-hero h1 { font-size: clamp(2.6rem, 6vw, 4.4rem); letter-spacing: -0.045em; margin-bottom: 0.18em; }
  .tagline { margin: 0; max-width: 760px; }
  .overview { justify-content: flex-start; max-width: none; margin: 26px 0 0; }
  .p-hero-img { width: 100%; margin: 36px 0 0; border-radius: 22px; }
  .p-hero-img.tall { width: min(100%, 520px); }
  .p-summary { gap: 14px; margin-top: 20px; text-align: left; }
  .p-summary > div { padding: 18px 20px; border-radius: 18px; background: var(--white); }
  .p-summary h2 { font-size: 0.75rem; margin-bottom: 6px; }
  .p-summary p { font-size: 1.02rem; }
  .chapter { width: min(100% - 40px, var(--band)); margin: 0 auto; padding: 52px 0; text-align: left; border-top: 1px solid var(--line); }
  [data-chapters] > .chapter:first-child { margin-top: 44px; }
  .chapter > * { margin-left: 0; margin-right: 0; }
  .chapter > .band { max-width: none; }
  .chapter .num { margin-bottom: 8px; }
  .chapter h2 { font-size: clamp(1.7rem, 2.8vw, 2.4rem); text-wrap: pretty; max-width: 820px; }
  .chapter > p { font-size: 1.1rem; max-width: var(--text); }
  .band { margin-top: 26px; }
  .chapter > p.pull, .band > p.pull, .pull { font-size: clamp(1.3rem, 2.2vw, 1.7rem); line-height: 1.32; }
  .chapter > p.pull { padding-left: 20px; border-left: 4px solid var(--accent-text); max-width: 820px; }
  .mycall { margin-top: 28px; padding: 26px 28px; text-align: left; }
  .mycall .answer { font-size: clamp(1.1rem, 1.8vw, 1.35rem); }
  .learn { max-width: var(--text); margin-top: 28px !important; padding: 14px 18px; border-top: 0; border-left: 4px solid var(--accent-text); border-radius: 0 14px 14px 0; background: var(--white); }
  .learn p { font-size: 1.18rem; }
  .bigstats { text-align: left; gap: 20px; }
  .bigstats b { font-size: clamp(2.4rem, 4.6vw, 3.6rem); }
  .bigstats span { margin-top: 6px; font-size: 1rem; }
  .decisions b { font-size: 1.25rem; }
  .ideas b { font-size: 1.25rem; }
  .takeaways-big li { font-size: 1.3rem; grid-template-columns: 44px 1fr; }
  .cols figcaption, .band figcaption { text-align: left; font-size: 0.98rem; }
  .p-next { width: min(100% - 40px, var(--band)); margin: 0 auto; justify-content: flex-start; padding: 56px 0 24px; border-top: 1px solid var(--line); }
  @media (max-width: 760px) {
    .p-hero { padding-top: 100px; }
    .chapter { padding: 40px 0; }
    .p-next { flex-direction: column; align-items: flex-start; }
    .next-copy { text-align: left; }
  }

  /* reading aids: progress bar, contents rail (desktop), contents pill (phone) */
  .read-progress { position: fixed; top: 0; left: 0; right: 0; z-index: 120; height: 3px; pointer-events: none; }
  .read-progress span { display: block; height: 100%; width: 0; background: var(--accent-text, #111); transition: width 0.1s linear; }
  .toc { position: fixed; left: max(16px, calc((100vw - 1040px) / 2 - 190px)); top: 50%; z-index: 50; width: 160px; transform: translateY(-50%); opacity: 0; pointer-events: none; transition: opacity 0.3s; }
  .toc.on { opacity: 1; pointer-events: auto; }
  .toc-title { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 10px; }
  .toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; border-left: 2px solid var(--line); }
  .toc a { display: block; margin-left: -2px; padding: 6px 0 6px 14px; border-left: 2px solid transparent; color: var(--ink-3); font-size: 0.88rem; line-height: 1.3; text-decoration: none; transition: color 0.2s, border-color 0.2s; }
  .toc a:hover { color: var(--ink); }
  .toc a[aria-current='true'] { color: var(--ink); font-weight: 600; border-color: var(--accent-text, #111); }
  .toc-pill { position: fixed; left: 50%; bottom: 18px; z-index: 60; transform: translate(-50%, 20px); opacity: 0; pointer-events: none; padding: 11px 18px; border: 0; border-radius: 999px; background: #111; color: #fff; font: 600 0.9rem var(--sans); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2); transition: opacity 0.3s, transform 0.3s var(--ease); max-width: calc(100vw - 40px); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .toc-pill.on { opacity: 1; transform: translate(-50%, 0); pointer-events: auto; }
  @media (max-width: 1279px) {
    .toc { left: 50%; top: auto; bottom: 70px; width: min(320px, calc(100vw - 40px)); transform: translateX(-50%); padding: 16px 18px; border-radius: 20px; background: #fff; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.18); opacity: 0 !important; pointer-events: none !important; }
    .toc.open { opacity: 1 !important; pointer-events: auto !important; }
  }
  @media (min-width: 1280px) { .toc-pill { display: none; } }
</style>

<script>
  // Contents list from chapter labels, scroll-spy, and a reading progress bar.
  const chapters = [...document.querySelectorAll<HTMLElement>('[data-chapters] > .chapter')].filter((c) => c.querySelector('.num'));
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  const list = document.querySelector<HTMLElement>('[data-toc-list]');
  const pill = document.querySelector<HTMLButtonElement>('[data-toc-pill]');
  const current = document.querySelector<HTMLElement>('[data-toc-current]');
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const label = (c: HTMLElement) => c.querySelector('.num')!.textContent!.replace(/^\d+\s*·\s*/, '').trim();
  if (toc && list && pill && chapters.length > 2) {
    toc.hidden = false; pill.hidden = false;
    const links = chapters.map((c, i) => {
      c.id ||= 'ch-' + (i + 1);
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = '#' + c.id; a.textContent = label(c);
      a.addEventListener('click', () => { toc.classList.remove('open'); pill.setAttribute('aria-expanded', 'false'); });
      li.append(a); list.append(li);
      return a;
    });
    pill.addEventListener('click', () => { const o = toc.classList.toggle('open'); pill.setAttribute('aria-expanded', String(o)); });
    const update = () => {
      const y = scrollY + innerHeight * 0.35;
      let on = -1;
      chapters.forEach((c, i) => { if (c.offsetTop <= y) on = i; });
      links.forEach((a, i) => a.setAttribute('aria-current', String(i === on)));
      const started = on >= 0;
      const end = document.querySelector<HTMLElement>('.p-next');
      const done = end ? end.getBoundingClientRect().top < innerHeight * 0.6 : false;
      toc.classList.toggle('on', started && !done);
      pill.classList.toggle('on', started && !done);
      if (current) current.textContent = on >= 0 ? label(chapters[on]) : 'Contents';
      if (bar) { const h = document.documentElement.scrollHeight - innerHeight; bar.style.width = (h > 0 ? (scrollY / h) * 100 : 0) + '%'; }
    };
    addEventListener('scroll', update, { passive: true }); addEventListener('resize', update); update();
  }
</script>
